# .env.example — Copy to .env.local and fill in values
# Required for live mode (not needed for DEMO_MODE=true)
GEMINI_API_KEY=your-gemini-api-key-here
# Primary model (Model 1)
GEMINI_MODEL=gemini-3.8-flash
# Fallback models (comma-separated: Fallback Model 2, Fallback Model 3)
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.5-flash-lite
# Set to "true" to run fully offline with fixtures and canned responses
DEMO_MODE=true
